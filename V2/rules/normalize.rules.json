      "id": "normalize.syn.part.001",
      "domain": "normalize",
      "priority": 507,
      "scope": "part",
      "when": {
        "part.workingName": {
          "op": "contains",
          "value": "信号开关安装板"
        }
      },
      "then": {
        "part.workingName": {
          "replaceAll": [
            "信号开关安装板",
            "限位开关安装板"
          ]
        }
      },
      "meta": {
        "status": "active",
        "version": 1,
        "author": "migration",
        "createdAt": "2026-08-13",
        "updatedAt": "2026-08-13",
        "rationale": "自旧 synonyms 迁移: 信号开关安装板→限位开关安装板（长词优先）",
        "tests": []
