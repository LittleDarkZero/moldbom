      "then": {
        "numberRange": {
          "min": 200,
          "max": 999
        }
      },
      "meta": {
        "status": "active",
        "version": 1,
        "author": "migration",
        "createdAt": "2026-08-13",
        "updatedAt": "2026-08-13",
        "rationale": "自旧 part_number_ranges 迁移：其余 200+ 兜底",
        "tests": []
      }
    }
  ]
